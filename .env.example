# ============================================================
# KILIMALLL — Environment Variable Reference
# Copy this to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development
# Restrict CORS to your own deployment origin in production
ALLOWED_ORIGIN=https://kilimalll.onrender.com

# --- Database (Neon PostgreSQL) ---
# Get from: https://console.neon.tech → your project → Connection details
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/kilimalll?sslmode=verify-full

# --- JWT Auth ---
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_byte_random_hex
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_different_64_byte_random_hex
JWT_REFRESH_EXPIRES_IN=7d

# --- Cloudflare R2 Storage ---
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET=kilimalll
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Public URL base for serving R2 assets (set after enabling public access on bucket)
R2_PUBLIC_URL=https://pub-XXXX.r2.dev

# --- Email (Resend) ---
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_replace_with_your_key
EMAIL_FROM=noreply@yourdomain.com

# --- Payments (PayHero / M-Pesa) ---
# Get from: https://dashboard.payhero.co.ke → API Keys
PAYHERO_API_KEY=replace_with_payhero_api_key
PAYHERO_USERNAME=replace_with_payhero_username
PAYHERO_PASSWORD=replace_with_payhero_password
# Your publicly reachable callback URL for PayHero webhooks
PAYHERO_CALLBACK_URL=https://kilimalll.onrender.com/api/payments/webhook

# --- App ---
APP_NAME=Kilimall
BASE_URL=https://kilimalll.onrender.com
